#include <stdio.h>

int main(void){

   float num1, num2, num3, num4, num5, media;

   printf("Digite 5 numeros:");
   scanf("%f", &num1);
   scanf("%f", &num2);
   scanf("%f", &num3);
   scanf("%f", &num4);
   scanf("%f", &num5);

   media = (num1 + num2 + num3 + num4 + num5) / 5;

   printf("A media aritmetica e: %.2f\n", media);

   return 0;
}
