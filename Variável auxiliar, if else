/* Faça um programa que leia 3 números inteiros e imprima-os em ordem crescente.
Criador: Laryssa Ribeiro
Data: 04/02/2026*/

#include <stdio.h>

int main(void)
{
   int num1, num2, num3, aux;

   printf("Digite 3 numeros");
   scanf("%d %d %d", &num1, &num2, &num3);

   if (num1 > num2)
   {
      aux = num1;
      num1 = num2;
      num2 = aux;
   }
   if (num1 > num3)
   {
      aux = num1;
      num1 = num3;
      num3 = aux;
   }
   if (num2 > num3)
   {
      aux = num2;
      num2 = num3;
      num3 = aux;
   }

   printf(" Ordem crescente: %d %d %d\n", num1, num2, num3);
   return 0;
}
