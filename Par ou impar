Criador: Laryssa Ribeiro
Data: 03/02/2026*/

#include <stdio.h>

int main(void)
{
   int num;

   printf("Digite um numero inteiro\n");
   scanf("%d", &num);

   if (num % 2 == 0)
   {
      printf("O numero e par");
   }
   else
   {
      printf("O numero e impar");
   }

   return 0;
}
