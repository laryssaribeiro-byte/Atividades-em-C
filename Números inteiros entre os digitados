Data: 01/03/2026*/

#include <stdio.h>

int main(void)
{
    int n1, n2;
    int i;

    printf("Digite o primeiro numero.");
    scanf("%d", &n1);

    printf("Digite o segundo numero.");
    scanf("%d", &n2);

    if (n1 < n2)
    {
        for (i = n1 + 1; i < n2; i++)
            printf("%d", i);
    }
    else
    {
        for (i = n2 + 1; i < n1; i++)
            printf("%d", i);
    }

    return 0;
}
