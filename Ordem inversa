/* Crie um programa que possibilite ao usuário preencher três variáveis: numero1, 
numero2 e numero3. Tendo preenchido, exiba-as na ordem inversa em que foram 
preenchidas: numero3, numero2 e numero1.
Criador: Laryssa Ribeiro
Data: 31/01/2026*/

#include <stdio.h>

int main (void){

   int numero1, numero2, numero3;
   printf("Digite tres numeros:");
   scanf("%d %d %d", &numero1, &numero2, &numero3);

   printf("Os numeros na ordem inversa sao:\n");
   printf("%d\n", numero3);
   printf("%d\n", numero2);
   printf("%d\n", numero1);
   return 0;
}
